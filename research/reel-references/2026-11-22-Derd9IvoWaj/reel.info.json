kNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fdXNlcl9zZWxlY3RlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=t58srURhYmkQ7kNvwEkN7nh&_nc_oc=Adr-F4iiVlOx08sDDNwVa83B0ZxmYCNs6giHP8meQwlor5hBu5L2IvHrMU0aKPh1LXQ&_nc_zt=23&_nc_ht=scontent-ord5-2.cdninstagram.com&_nc_gid=yxI7KaP0Qc8hmKQvJkmZmQ&_nc_ss=70689&_nc_ct=RQosPBUIFQ4lBAAAAA&oh=00_AQR3_Br7m7IHlOptsOBA7TV8U_DVc_QV-vWFP9n7VxsS8A&oe=6B09116D", "width": 720, "height": 720, "id": "10", "resolution": "720x720"}, {"url": "https://scontent-ord5-2.cdninstagram.com/v/t51.82787-15/859025902_18640947259042700_3310649149425725321_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&_nc_map=urlgen_bucketless&ig_cache_key=NDAxMTQzMTYzNzcyOTUwMjg4MzE4NjQwOTQ3MjU2MDQyNzAw.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fdXNlcl9zZWxlY3RlZF90aHVtYm5haWwuQzMifQ%3D%3D&_nc_ohc=t58srURhYmkQ7kNvwEkN7nh&_nc_oc=Adr-F4iiVlOx08sDDNwVa83B0ZxmYCNs6giHP8meQwlor5hBu5L2IvHrMU0aKPh1LXQ&_nc_zt=23&_nc_ht=scontent-ord5-2.cdninstagram.com&_nc_gid=yxI7KaP0Qc8hmKQvJkmZmQ&_nc_ss=70689&_nc_ct=RQosPBUIFQ4lBAAAAA&oh=00_AQQMuJnQyD4qheila2viXumWB7oMNdWeV315awSA6TMxLw&oe=6B09116D", "width": 720, "height": 1280, "id": "11", "resolution": "720x1280"}], "comments": [{"author": "asa_living", "author_id": "40742494022", "id": "18112105901223593", "text": "100% agree, do it yourself, we have all the time for this, do not degrade ourselves with the slops", "timestamp": 1795353515, "like_count": 0}, {"author": "srishteatiime", "author_id": "3148062878", "id": "18509536684102176", "text": "Loveeee this", "timestamp": 1795350256, "like_count": 0}, {"author": "miyelain", "author_id": "46811983496", "id": "17919059505544762", "text": "@var.aunevik  lol", "timestamp": 1795339926, "like_count": 0}, {"author": "tionnacmarsh", "author_id": "48422293044", "id": "17880178080573435", "text": "Love this take!", "timestamp": 1795320151, "like_count": 0}, {"author": "clydehust1es", "author_id": "56039521718", "id": "18064886936716995", "text": "Would you recommend AI for editing?", "timestamp": 1795227895, "like_count": 0}, {"author": "allfacesphillip", "author_id": "29825499272", "id": "18130437676858533", "text": "The video I pulled after this has the style of editing you’re describing. In fact, it’s a list of the \"best transitions\" 🤣🥴", "timestamp": 1795222476, "like_count": 0}, {"author": "dr.shivasana", "author_id": "4678592", "id": "18001785606019391", "text": "Love love love!", "timestamp": 1795205260, "like_count": 0}, {"author": "filip______chaplin", "author_id": "41953153372", "id": "17957616933035252", "text": "I agree but it’s sad to see the insane dominance of overstimulating content. Just go on the nyc subway and you’ll hear it", "timestamp": 1795188963, "like_count": 0}, {"author": "amymariehann", "author_id": "278124785", "id": "18121881976975579", "text": "Get better. That’s my main lesson from 2026. I think all the AI stuff is feeding this lie that if it’s hard then you’re doing something wrong but if you have a calling to serve and educate and help, no one said that should be easy. Get better at telling stories and communicating your ideas. Sure I can get better at editing and being more concise but the more I embrace getting better and ignore the noise the happier I am and the better my content.", "timestamp": 1795183974, "like_count": 0}, {"author": "createwithyanet_", "author_id": "66149937363", "id": "18342104005276720", "text": "I absolutely hate the narrative being pushed of having to have overstimulated edits. IM TIREDD i miss the days where you would just post good content and it wojld perform well", "timestamp": 1795182639, "like_count": 0}, {"author": "edits_with_naw", "author_id": "70039845540", "id": "17955816009284970", "text": "I love that. This is so true. Ur content is soo soothing and cozy", "timestamp": 1795150493, "like_count": 0}, {"author": "lgnwvr", "author_id": "4002871672", "id": "18080359766777937", "text": "Just tell us u can’t edit", "timestamp": 1795148457, "like_count": 0}], "webpage_url